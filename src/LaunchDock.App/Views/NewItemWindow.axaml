<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LaunchDock.App.Views.NewItemWindow"
        Title="新建项目"
        Icon="/Assets/app.png"
        Width="480"
        Height="380"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextSecondary}" Text="类型" />
      <ComboBox x:Name="TypeBox" SelectedIndex="0" SelectionChanged="OnTypeChanged">
        <ComboBoxItem Content="程序 / 快捷方式" />
        <ComboBoxItem Content="文件" />
        <ComboBoxItem Content="文件夹" />
        <ComboBoxItem Content="网址" />
        <ComboBoxItem Content="命令" />
        <ComboBoxItem Content="内置动作" />
      </ComboBox>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6">
      <TextBlock FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextSecondary}" Text="显示名称" />
      <TextBox x:Name="NameBox" Watermark="留空则使用文件名" />
    </StackPanel>

    <StackPanel x:Name="TargetPanel" Grid.Row="2" Margin="0,12,0,0" Spacing="6">
      <TextBlock FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextSecondary}" Text="目标路径 / URL / 命令" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="TargetBox" />
        <Button x:Name="BrowseButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Content="浏览"
                Click="OnBrowseClick" />
      </Grid>
    </StackPanel>

    <StackPanel x:Name="BuiltinPanel"
                Grid.Row="3"
                Margin="0,12,0,0"
                Spacing="6"
                IsVisible="False">
      <TextBlock FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextSecondary}" Text="内置动作" />
      <ComboBox x:Name="ActionBox" SelectedIndex="0" />
    </StackPanel>

    <TextBlock Grid.Row="4"
               Margin="0,12,0,0"
               VerticalAlignment="Top"
               Classes="hint"
               Text="提示：程序可以直接填 exe 路径或 shell 命令；网址以 http/https 开头；内置动作无需填写目标。" />

    <StackPanel Grid.Row="5"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
      <Button MinWidth="80" Content="取消" Click="OnCancelClick" />
      <Button MinWidth="80" Content="确定" Click="OnConfirmClick" IsDefault="True" />
    </StackPanel>

  </Grid>

</Window>
