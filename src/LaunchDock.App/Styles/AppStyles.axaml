<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 全局字体：字体族 / 字重 / 基准字号均由设置里的 AppFontFamily、AppFontWeight、FsBase 资源驱动；
       各处字号使用 FsXX token，可随“字体大小”设置等比缩放 -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontWeight" Value="{DynamicResource AppFontWeight}" />
    <Setter Property="FontSize" Value="{DynamicResource FsBase}" />
  </Style>

  <!-- Fluent 主题把 TabItem 表头字重固定成 SemiLight，会让左侧导航比正文明显偏细；
       这里拉回全局字重，保证所有界面文字观感一致 -->
  <Style Selector="TabItem">
    <Setter Property="FontWeight" Value="{DynamicResource AppFontWeight}" />
  </Style>

  <Style Selector="Button.chrome">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.chrome:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="Button.tab">
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="6">
          <Grid RowDefinitions="*,2">
            <ContentPresenter Grid.Row="0"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            <Border Grid.Row="1"
                    Name="Underline"
                    Width="18"
                    Height="2"
                    CornerRadius="1"
                    Background="{DynamicResource Accent}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.tab.active">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.tab.active /template/ Border#Underline">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- 暖棕药丸开关：设置页统一使用，仅覆盖 Fluent 模板的颜色资源 -->
  <Style Selector="ToggleSwitch.compact">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="OnContent" Value="On" />
    <Setter Property="OffContent" Value="Off" />
    <Style.Resources>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF8A6A5C" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF7A5B4D" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF6F5347" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF8A6A5C" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF7A5B4D" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF6F5347" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
    </Style.Resources>
  </Style>

  <Style Selector="ToggleSwitch.compact:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource Fs18}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{DynamicResource Fs11.5}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 菜单浮层：字号与内边距跟随面板排版 -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="MinWidth" Value="188" />
    <Setter Property="Padding" Value="0,4" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

</Styles>
