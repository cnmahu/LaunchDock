<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LaunchDock.App.App">

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon ToolTipText="启坞 LaunchDock" Icon="/Assets/app.png">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="显示启动板" Click="OnTrayShowClick" />
            <NativeMenuItem Header="设置" Click="OnTraySettingsClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="退出" Click="OnTrayExitClick" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TextPrimary" Color="#FF423C37" />
          <SolidColorBrush x:Key="TextSecondary" Color="#FF8A8178" />
          <SolidColorBrush x:Key="Divider" Color="#14000000" />
          <SolidColorBrush x:Key="PanelBackground" Color="#B8FFFFFF" />
          <SolidColorBrush x:Key="WindowBackground" Color="#FFFBF7F5" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#12000000" />
          <SolidColorBrush x:Key="HoverBrush" Color="#12000000" />
          <SolidColorBrush x:Key="SearchBackground" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="SearchBorder" Color="#26000000" />
          <SolidColorBrush x:Key="NavSelected" Color="#F2E4DE" />

          <!-- 菜单浮层：与面板同一套颜色 -->
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
          <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FF423C37" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#12000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FF423C37" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1C000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FF423C37" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#FFB3B3B3" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#FF6B6B6B" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#FF4A4A4A" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#FF4A4A4A" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#FFB3B3B3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TextPrimary" Color="#FFF3F3F3" />
          <SolidColorBrush x:Key="TextSecondary" Color="#FFA9A9A9" />
          <SolidColorBrush x:Key="Divider" Color="#22FFFFFF" />
          <SolidColorBrush x:Key="PanelBackground" Color="#CC1C1C1C" />
          <SolidColorBrush x:Key="WindowBackground" Color="#FF1C1C1C" />
          <SolidColorBrush x:Key="CardBackground" Color="#FF262626" />
          <SolidColorBrush x:Key="CardBorder" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="SearchBackground" Color="#22FFFFFF" />
          <SolidColorBrush x:Key="SearchBorder" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="NavSelected" Color="#3A2A24" />

          <!-- 菜单浮层：与面板同一套颜色 -->
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF262626" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#22FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
          <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FFF3F3F3" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFF3F3F3" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFF3F3F3" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#FF6B6B6B" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#FFA9A9A9" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#FFC4C4C4" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#FFC4C4C4" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#FF6B6B6B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="Accent" Color="#FF8A6A5C" />
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

      <!-- 全局字体资源：拉丁字母用系统 Segoe UI，中文用微软雅黑回退；
           字重 Light 同时取到 Segoe UI Light 与微软雅黑 Light（Skia 无独立 "Microsoft YaHei Light" 族名）。
           运行时由 SettingsViewModel.ApplyFont 按设置覆盖。
           ContentControlThemeFontFamily 是 Fluent 主题里各控件 ControlTheme 使用的资源，
           不覆盖它的话按钮、列表项等控件会绕过继承，继续用主题默认字体。 -->
      <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Microsoft YaHei</FontFamily>
      <FontWeight x:Key="AppFontWeight">Normal</FontWeight>
      <x:Double x:Key="FsBase">12</x:Double>
      <x:Double x:Key="Fs11">11</x:Double>
      <x:Double x:Key="Fs11.5">11.5</x:Double>
      <x:Double x:Key="Fs12">12</x:Double>
      <x:Double x:Key="Fs12.5">12.5</x:Double>
      <x:Double x:Key="Fs13">13</x:Double>
      <x:Double x:Key="Fs13.5">13.5</x:Double>
      <x:Double x:Key="Fs14">14</x:Double>
      <x:Double x:Key="Fs15">15</x:Double>
      <x:Double x:Key="Fs16">16</x:Double>
      <x:Double x:Key="Fs18">18</x:Double>
      <x:Double x:Key="Fs24">24</x:Double>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://LaunchDock/Styles/AppStyles.axaml" />
  </Application.Styles>

</Application>
