<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RolanClone.App.Views.SettingsWindow"
        Title="设置"
        Icon="/Assets/app.png"
        Width="780"
        Height="620"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="{DynamicResource PanelBackground}">

  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="Width" Value="170" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}"
                  Margin="0,1">
            <ContentPresenter Content="{TemplateBinding Header}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource NavSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.rowHint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.rowIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="Background" Value="{DynamicResource Divider}" />
    </Style>
    <Style Selector="Border.subrow">
      <Setter Property="Margin" Value="44,0,16,12" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SearchBackground}" />
    </Style>
    <Style Selector="ToggleSwitch.compact">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="37,*">

      <Grid Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Background="Transparent"
            PointerPressed="OnTitleBarPressed">
        <TextBlock Grid.Column="0"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Text="设置" />
        <Button Grid.Column="2"
                Classes="chrome"
                Margin="0,0,6,0"
                ToolTip.Tip="关闭"
                Click="OnCloseClick">
          <Path Data="M4,4 L14,14 M14,4 L4,14"
                Stroke="{DynamicResource TextSecondary}"
                StrokeThickness="1.3"
                StrokeLineCap="Round" />
        </Button>
      </Grid>

      <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="10,4,16,14">

        <TabItem Header="概要">
          <ScrollViewer>
            <StackPanel Margin="16,6" Spacing="6">
              <TextBlock Classes="section" Text="应用" />
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="启坞 LaunchDock" />
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         Text="{Binding VersionText}" />
              <Button Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Content="关于启坞"
                      Click="OnAboutClick" />

              <TextBlock Classes="section" Text="配置文件" />
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"
                         Text="{Binding ConfigPath}" />
              <Button Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Content="打开配置目录"
                      Click="OnOpenConfigFolderClick" />

              <TextBlock Classes="section" Text="便签" />
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"
                         Text="{Binding NotesDirectoryPath}" />
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                <Button Content="更改目录" Click="OnChangeNotesDirectoryClick" />
                <Button Content="打开便签目录" Click="OnOpenNotesDirectoryClick" />
                <Button Content="恢复默认"
                        IsEnabled="{Binding HasCustomNotesDirectory}"
                        Click="OnResetNotesDirectoryClick" />
              </StackPanel>

              <TextBlock Classes="section" Text="快捷键" />
              <TextBlock Classes="hint" Text="Alt+Space 显示 / 隐藏面板；Ctrl+F 搜索；Esc 关闭搜索；右键分组标签可重命名或删除。" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="外观">
          <ScrollViewer>
            <StackPanel Margin="16,10,16,16" Spacing="12">
              <TextBlock Classes="pageTitle" Margin="2,0,0,4" Text="外观" />

              <Border Classes="card">
                <Grid ColumnDefinitions="*,220" Margin="16,14">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="cardTitle" Text="主题" />
                    <TextBlock Classes="hint" Text="跟随系统、浅色或深色" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            Width="180"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            SelectedIndex="{Binding ThemeIndex}">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                  </ComboBox>
                </Grid>
              </Border>

              <Border Classes="card">
                <StackPanel Margin="16,14" Spacing="14">
                  <Grid ColumnDefinitions="*,220">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="窗口材质" />
                      <TextBlock Classes="hint" Text="亚克力支持 Win10/11，云母仅 Windows 11，纯色最省资源。" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="180"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding MaterialIndex}">
                      <ComboBoxItem Content="亚克力" />
                      <ComboBoxItem Content="云母" />
                      <ComboBoxItem Content="纯色" />
                    </ComboBox>
                  </Grid>

                  <Grid ColumnDefinitions="*,220">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="面板不透明度" />
                      <TextBlock Classes="hint" Text="数值越低，背景透光越明显" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <Slider Width="160"
                              Minimum="0.5"
                              Maximum="1"
                              TickFrequency="0.01"
                              IsSnapToTickEnabled="True"
                              Value="{Binding Opacity}" />
                      <TextBlock Width="40"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextSecondary}"
                                 Text="{Binding OpacityLabel}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Margin="16,14" Spacing="14">
                  <Grid ColumnDefinitions="*,220">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="图标大小" />
                      <TextBlock Classes="hint" Text="24 – 96 像素" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <Slider Width="160"
                              Minimum="24"
                              Maximum="96"
                              TickFrequency="4"
                              IsSnapToTickEnabled="True"
                              Value="{Binding IconSizePx}" />
                      <TextBlock Width="44"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextSecondary}"
                                 Text="{Binding IconSizeLabel}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,220">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="图标间距" />
                      <TextBlock Classes="hint" Text="固定间距，不随窗口宽度变化" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <Slider Width="160"
                              Minimum="0"
                              Maximum="48"
                              TickFrequency="2"
                              IsSnapToTickEnabled="True"
                              Value="{Binding IconSpacing}" />
                      <TextBlock Width="44"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextSecondary}"
                                 Text="{Binding IconSpacingLabel}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,220">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="名称位置" />
                      <TextBlock Classes="hint" Text="图标下方、右侧或隐藏" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding LabelPositionIndex}">
                      <ComboBoxItem Content="图标下方" />
                      <ComboBoxItem Content="图标右侧" />
                      <ComboBoxItem Content="隐藏名称" />
                    </ComboBox>
                  </Grid>

                  <Grid ColumnDefinitions="*,220">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="启动板布局" />
                      <TextBlock Classes="hint" Text="网格或单列列表" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding LayoutIndex}">
                      <ComboBoxItem Content="网格" />
                      <ComboBoxItem Content="列表" />
                    </ComboBox>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <Grid ColumnDefinitions="*,220" Margin="16,14">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="cardTitle" Text="窗口置顶" />
                    <TextBlock Classes="hint" Text="始终显示在其他窗口之上" />
                  </StackPanel>
                  <CheckBox Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsChecked="{Binding TopMost}" />
                </Grid>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="行为">
          <ScrollViewer>
            <StackPanel Margin="16,6" Spacing="4">
              <TextBlock Classes="section" Text="启动" />
              <CheckBox Classes="option" Content="开机自动启动" IsChecked="{Binding AutoStart}" />
              <CheckBox Classes="option" Content="启动时隐藏窗口，仅在后台运行" IsChecked="{Binding StartHidden}" />

              <TextBlock Classes="section" Text="打开方式" />
              <ComboBox Width="180"
                        Margin="0,2,0,6"
                        HorizontalAlignment="Left"
                        SelectedIndex="{Binding OpenModeIndex}">
                <ComboBoxItem Content="单击打开" />
                <ComboBoxItem Content="双击运行" />
              </ComboBox>

              <TextBlock Classes="section" Text="隐藏" />
              <CheckBox Classes="option" Content="启动项目后隐藏" IsChecked="{Binding HideAfterLaunch}" />
              <CheckBox Classes="option" Content="在空白区域双击时隐藏" IsChecked="{Binding HideOnEmptyDoubleClick}" />

              <TextBlock Classes="section" Text="窗口" />
              <CheckBox Classes="option" Content="拖动到屏幕边缘时自动吸附" IsChecked="{Binding EdgeSnap}" />
              <CheckBox Classes="option" Content="锁定窗口位置与尺寸" IsChecked="{Binding LockPosition}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="唤出与收起">
          <ScrollViewer>
            <StackPanel Margin="16,10,16,16" Spacing="10">
              <TextBlock Classes="pageTitle" Margin="2,0,0,4" Text="唤出与收起" />

              <Border Classes="card">
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE707;" />
                    <TextBlock Grid.Column="1" Classes="rowTitle" Margin="12,0" Text="面板唤出位置" />
                    <ComboBox Grid.Column="2"
                              Width="150"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding ShowPositionIndex}">
                      <ComboBoxItem Content="当前位置" />
                      <ComboBoxItem Content="屏幕中央" />
                      <ComboBoxItem Content="鼠标位置" />
                    </ComboBox>
                  </Grid>

                  <Border Classes="separator" />

                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE765;" />
                    <TextBlock Grid.Column="1" Classes="rowTitle" Margin="12,0" Text="通过键盘快捷键唤出面板" />
                    <ToggleSwitch Grid.Column="2"
                                  Classes="compact"
                                  IsChecked="{Binding EnableHotkey}"
                                  OnContent="On"
                                  OffContent="Off" />
                  </Grid>

                  <Border Classes="subrow">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock VerticalAlignment="Center"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Text="快捷键是" />
                      <TextBox x:Name="HotkeyBox"
                               Grid.Column="1"
                               Width="180"
                               IsEnabled="{Binding EnableHotkey}"
                               Text="{Binding Hotkey, Mode=OneWay}"
                               KeyDown="OnHotkeyKeyDown"
                               LostFocus="OnHotkeyLostFocus" />
                    </Grid>
                  </Border>

                  <TextBlock x:Name="HotkeyStatus"
                             Margin="60,0,16,10"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondary}" />

                  <Border Classes="separator" />

                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE718;" />
                    <TextBlock Grid.Column="1" Classes="rowTitle" Margin="12,0" Text="通过任务栏图标唤出面板" />
                    <Button Grid.Column="2"
                            Classes="action"
                            Content="固定到任务栏"
                            Click="OnPinTaskbarClick" />
                  </Grid>

                  <Border Classes="separator" />

                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE7F4;" />
                    <TextBlock Grid.Column="1" Classes="rowTitle" Margin="12,0" Text="通过桌面图标唤出面板" />
                    <Button Grid.Column="2"
                            Classes="action"
                            Content="创建桌面图标"
                            Click="OnCreateDesktopIconClick" />
                  </Grid>

                  <TextBlock x:Name="ShortcutStatus"
                             Margin="60,0,16,10"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondary}" />

                  <Border Classes="separator" />

                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE962;" />
                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="2">
                      <TextBlock Classes="rowTitle" Text="通过鼠标第一个扩展键唤出面板" />
                      <TextBlock Classes="rowHint" Text="需鼠标带有扩展按键" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  Classes="compact"
                                  IsChecked="{Binding ShowOnXButton1}"
                                  OnContent="On"
                                  OffContent="Off" />
                  </Grid>

                  <Border Classes="separator" />

                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE962;" />
                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="2">
                      <TextBlock Classes="rowTitle" Text="通过鼠标第二个扩展键唤出面板" />
                      <TextBlock Classes="rowHint" Text="需鼠标带有扩展按键" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  Classes="compact"
                                  IsChecked="{Binding ShowOnXButton2}"
                                  OnContent="On"
                                  OffContent="Off" />
                  </Grid>

                  <Border Classes="separator" />

                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE962;" />
                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="2">
                      <TextBlock Classes="rowTitle" Text="通过鼠标中键唤出面板" />
                      <TextBlock Classes="rowHint" Text="不推荐，可能导致系统性能下降。许多其他应用也会高频使用中键，开启此项可能造成功能冲突或意外触发。" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  Classes="compact"
                                  IsChecked="{Binding ShowOnMiddleClick}"
                                  OnContent="On"
                                  OffContent="Off" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE70D;" />
                    <TextBlock Grid.Column="1" Classes="rowTitle" Margin="12,0" Text="自动收起面板" />
                    <ToggleSwitch Grid.Column="2"
                                  Classes="compact"
                                  IsChecked="{Binding HideOnLostFocus}"
                                  OnContent="On"
                                  OffContent="Off" />
                  </Grid>

                  <Border Classes="subrow">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock VerticalAlignment="Center"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Text="按住 Ctrl 键时阻止自动收起" />
                      <ToggleSwitch Grid.Column="1"
                                    Classes="compact"
                                    IsChecked="{Binding CtrlPreventHide}"
                                    IsEnabled="{Binding HideOnLostFocus}"
                                    OnContent="On"
                                    OffContent="Off" />
                    </Grid>
                  </Border>

                  <Border Classes="separator" />

                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                    <TextBlock Grid.Column="0" Classes="rowIcon" Text="&#xE711;" />
                    <TextBlock Grid.Column="1" Classes="rowTitle" Margin="12,0" Text="按下 ESC 键收起面板" />
                    <ToggleSwitch Grid.Column="2"
                                  Classes="compact"
                                  IsChecked="{Binding CloseOnEsc}"
                                  OnContent="On"
                                  OffContent="Off" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="安全">
          <ScrollViewer>
            <StackPanel Margin="16,6" Spacing="8" Width="460" HorizontalAlignment="Left">
              <TextBlock Classes="section" Text="启动板密码" />
              <TextBlock FontSize="13" Text="{Binding PasswordStatus}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="设置 / 修改密码" Click="OnSetPasswordClick" />
                <Button Content="清除密码" Click="OnClearPasswordClick" IsEnabled="{Binding HasPassword}" />
              </StackPanel>
              <CheckBox Classes="option"
                        Content="隐藏面板时自动锁定"
                        IsChecked="{Binding AutoLock}"
                        IsEnabled="{Binding HasPassword}" />
              <TextBlock Classes="hint" Text="密码使用 PBKDF2-SHA256 加盐存储，不保存明文。" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="维护">
          <ScrollViewer>
            <StackPanel Margin="16,10,16,16" Spacing="10">
              <TextBlock Classes="pageTitle" Margin="2,0,0,4" Text="维护" />

              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14">
                  <TextBlock Grid.Column="0"
                             Width="24"
                             VerticalAlignment="Center"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="16"
                             Foreground="{DynamicResource TextSecondary}"
                             Text="&#xE90F;" />
                  <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3">
                    <TextBlock Classes="cardTitle" Text="修复图标" />
                    <TextBlock Classes="hint" Text="清除图标缓存并重新提取所有图标" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Classes="action"
                          Content="执行"
                          Tag="RepairIcons"
                          Click="OnMaintenanceClick" />
                </Grid>
              </Border>

              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14">
                  <TextBlock Grid.Column="0"
                             Width="24"
                             VerticalAlignment="Center"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="16"
                             Foreground="{DynamicResource TextSecondary}"
                             Text="&#xE8CB;" />
                  <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3">
                    <TextBlock Classes="cardTitle" Text="按名称排序全部项" />
                    <TextBlock Classes="hint" Text="按显示名称重新排列每个分组内的条目" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Classes="action"
                          Content="执行"
                          Tag="SortByName"
                          Click="OnMaintenanceClick" />
                </Grid>
              </Border>

              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14">
                  <TextBlock Grid.Column="0"
                             Width="24"
                             VerticalAlignment="Center"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="16"
                             Foreground="{DynamicResource TextSecondary}"
                             Text="&#xE8C8;" />
                  <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3">
                    <TextBlock Classes="cardTitle" Text="清理全部重复项" />
                    <TextBlock Classes="hint" Text="同一分组内目标相同的条目只保留一个" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Classes="action"
                          Content="执行"
                          Tag="RemoveDuplicates"
                          Click="OnMaintenanceClick" />
                </Grid>
              </Border>

              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14">
                  <TextBlock Grid.Column="0"
                             Width="24"
                             VerticalAlignment="Center"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="16"
                             Foreground="{DynamicResource TextSecondary}"
                             Text="&#xE7BA;" />
                  <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3">
                    <TextBlock Classes="cardTitle" Text="清理全部失效项" />
                    <TextBlock Classes="hint" Text="移除目标文件或文件夹已不存在的条目" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Classes="action"
                          Content="执行"
                          Tag="RemoveInvalid"
                          Click="OnMaintenanceClick" />
                </Grid>
              </Border>

              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14">
                  <TextBlock Grid.Column="0"
                             Width="24"
                             VerticalAlignment="Center"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="16"
                             Foreground="{DynamicResource TextSecondary}"
                             Text="&#xE71D;" />
                  <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3">
                    <TextBlock Classes="cardTitle" Text="清理空标签" />
                    <TextBlock Classes="hint" Text="移除没有任何条目的空分组（至少保留一个）" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Classes="action"
                          Content="执行"
                          Tag="RemoveEmptyTabs"
                          Click="OnMaintenanceClick" />
                </Grid>
              </Border>

              <TextBlock Margin="4,4,0,0"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         Text="{Binding MaintenanceStatus}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>

    </Grid>
  </Border>

</Window>
