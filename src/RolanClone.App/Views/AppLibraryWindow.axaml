<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="RolanClone.App.Views.AppLibraryWindow"
        Title="应用库"
        Icon="/Assets/app.png"
        Width="720"
        Height="580"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="#B8FFFFFF">

  <Window.Resources>
    <ItemsPanelTemplate x:Key="LibraryItemsPanel">
      <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="LibraryItemTemplate">
      <Border Classes="tile"
              Width="{Binding TileWidth}"
              Height="{Binding TileHeight}"
              Margin="{Binding TileMargin}"
              CornerRadius="8"
              VerticalAlignment="Top"
              PointerPressed="OnTilePointerPressed"
              PointerMoved="OnTilePointerMoved"
              DoubleTapped="OnTileDoubleTapped"
              ToolTip.Tip="{Binding ToolTip}">
        <StackPanel VerticalAlignment="Center"
                    Spacing="6"
                    Orientation="{Binding LabelOrientation}">
          <Panel Width="{Binding IconSize}"
                 Height="{Binding IconSize}"
                 HorizontalAlignment="Center">
            <Border CornerRadius="10"
                    Background="{Binding Accent}"
                    IsVisible="{Binding !HasIcon}">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="White"
                         Text="{Binding Initials}" />
            </Border>
            <Image Source="{Binding Icon}"
                   Stretch="Uniform"
                   IsVisible="{Binding HasIcon}"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Panel>
          <TextBlock Margin="2,0"
                     HorizontalAlignment="{Binding LabelAlignment}"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource TextPrimary}"
                     Text="{Binding Name}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding ShowLabel}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <!-- 标签页与启动板分组标签保持同一套外观 -->
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <Grid RowDefinitions="*,2">
              <ContentPresenter Grid.Row="0"
                                Content="{TemplateBinding Header}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
              <Border Grid.Row="1"
                      Name="Underline"
                      Width="18"
                      Height="2"
                      CornerRadius="1"
                      Background="{DynamicResource Accent}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      IsVisible="False" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#Underline">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Window.Styles>

  <Border CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="37,*">

      <!-- 标题栏：拖动区域 + 关闭 -->
      <Grid Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Background="Transparent"
            PointerPressed="OnTitleBarPressed">
        <TextBlock Grid.Column="0"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="12.5"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="应用库" />
        <TextBlock Grid.Column="1"
                   Margin="12,0"
                   VerticalAlignment="Center"
                   FontSize="11.5"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="双击条目添加到启动板，或直接拖拽"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2"
                Classes="chrome"
                Margin="0,0,6,0"
                Focusable="False"
                ToolTip.Tip="关闭"
                Click="OnCloseClick">
          <Path Data="M4,4 L14,14 M14,4 L4,14"
                Stroke="{DynamicResource TextSecondary}"
                StrokeThickness="1.3"
                StrokeLineCap="Round" />
        </Button>
      </Grid>

      <TabControl Grid.Row="1"
                  Padding="8,0,8,8"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">

        <TabItem Header="标准文件夹">
          <ScrollViewer Padding="8,4,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding StandardFolders}"
                          ItemsPanel="{StaticResource LibraryItemsPanel}"
                          ItemTemplate="{StaticResource LibraryItemTemplate}"
                          VerticalAlignment="Top" />
          </ScrollViewer>
        </TabItem>

        <TabItem Header="系统应用">
          <ScrollViewer Padding="8,4,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SystemTools}"
                          ItemsPanel="{StaticResource LibraryItemsPanel}"
                          ItemTemplate="{StaticResource LibraryItemTemplate}"
                          VerticalAlignment="Top" />
          </ScrollViewer>
        </TabItem>

        <TabItem Header="桌面应用">
          <ScrollViewer Padding="8,4,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DesktopApps}"
                          ItemsPanel="{StaticResource LibraryItemsPanel}"
                          ItemTemplate="{StaticResource LibraryItemTemplate}"
                          VerticalAlignment="Top" />
          </ScrollViewer>
        </TabItem>

        <TabItem Header="商店应用">
          <ScrollViewer Padding="8,4,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding StoreApps}"
                          ItemsPanel="{StaticResource LibraryItemsPanel}"
                          ItemTemplate="{StaticResource LibraryItemTemplate}"
                          VerticalAlignment="Top" />
          </ScrollViewer>
        </TabItem>

        <TabItem Header="网页应用">
          <ScrollViewer Padding="8,4,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding WebApps}"
                          ItemsPanel="{StaticResource LibraryItemsPanel}"
                          ItemTemplate="{StaticResource LibraryItemTemplate}"
                          VerticalAlignment="Top" />
          </ScrollViewer>
        </TabItem>

        <TabItem Header="扩展应用">
          <ScrollViewer Padding="8,4,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Extensions}"
                          ItemsPanel="{StaticResource LibraryItemsPanel}"
                          ItemTemplate="{StaticResource LibraryItemTemplate}"
                          VerticalAlignment="Top" />
          </ScrollViewer>
        </TabItem>

      </TabControl>

    </Grid>
  </Border>

</Window>
