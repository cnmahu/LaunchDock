  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaunchDock.Core\LaunchDock.Core.csproj" />
  </ItemGroup>

</Project>
